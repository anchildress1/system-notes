{
  "name": "system-notes",
  "version": "2.5.4",
  "private": true,
  "scripts": {
    "predev": "npm run image-variants",
    "dev": "next dev --port 3000",
    "prebuild": "npm run image-variants",
    "build": "next build",
    "prebuild:analyze": "npm run image-variants",
    "build:analyze": "ANALYZE=true next build",
    "postbuild": "if [ -d .next/standalone ]; then mkdir -p .next/standalone/.next && cp -r .next/static .next/standalone/.next/static && cp -r public .next/standalone/public; fi",
    "start": "next start",
    "start:standalone": "[ -f .next/standalone/server.js ] && node .next/standalone/server.js || (echo 'Error: Standalone build not found. Run npm run build first.' && exit 1)",
    "lint": "ESLINT_USE_FLAT_CONFIG=true eslint --config eslint.config.mjs .",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run image-variants",
    "test": "vitest run --coverage",
    "pretest:watch": "npm run image-variants",
    "test:watch": "vitest",
    "test:perf": "npm run build && lhci collect --config=lighthouserc.desktop.json && lhci assert --config=lighthouserc.desktop.json && lhci collect --config=lighthouserc.mobile.json && lhci assert --config=lighthouserc.mobile.json",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,js,mjs,cjs,yml,yaml,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json,js,mjs,cjs,yml,yaml,css}\"",
    "audit": "npm audit --audit-level=high",
    "image-variants": "node scripts/generate-image-variants.mjs",
    "clean": "rm -rf node_modules .next coverage",
    "postinstall": "[ ! -d .git ] || lefthook install"
  },
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=26"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.82",
    "@algolia/client-common": "^5.48.0",
    "ai": "^7.0.79",
    "algoliasearch": "^5.48.0",
    "instantsearch.css": "^8.9.0",
    "instantsearch.js": "^4.99.0",
    "next": "16.3.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-icons": "^5.5.0",
    "react-instantsearch": "^7.45.0",
    "search-insights": "^2.17.3"
  },
  "optionalDependencies": {
    "@esbuild/linux-x64": "0.27.2",
    "@rollup/rollup-linux-x64-gnu": "4.62.4",
    "lightningcss-linux-x64-gnu": "1.33.0",
    "lightningcss-linux-x64-musl": "1.31.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@commitlint/cli": "^20.3.1",
    "@commitlint/config-conventional": "^20.3.1",
    "@lhci/cli": "^0.15.1",
    "@next/bundle-analyzer": "16.3.0",
    "@playwright/test": "^1.57.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/coverage-v8": "^4.0.17",
    "commitlint-plugin-rai": "^1.0.1",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.0",
    "jsdom": "^27.4.0",
    "lefthook": "^2.0.15",
    "prettier": "^3.8.0",
    "sharp": "^0.35.3",
    "typescript": "^5",
    "vitest": "^4.0.17"
  },
  "overrides": {
    "inquirer": "^8.2.7",
    "tmp": "^0.2.7",
    "qs": "^6.15.2",
    "mkdirp": "^1.0.4",
    "minimatch": "^9.0.9",
    "rollup": "^4.59.0",
    "next": "$next",
    "uuid": "^14.0.0",
    "postcss": ">=8.5.23 <9",
    "nanoid": "^3.3.18",
    "chrome-launcher": "^1.2.1",
    "ip-address": "^10.3.1",
    "fast-uri": "^3.1.5",
    "sharp": "^0.35.3",
    "react": "$react",
    "react-dom": "$react-dom",
    "vite": "^8.0.16",
    "@babel/core": "^7.29.6",
    "js-yaml": "^4.3.0",
    "@opentelemetry/core": "^2.8.0",
    "@opentelemetry/resources": "^2.8.0",
    "instantsearch.js": {
      "qs": "^6.15.2"
    },
    "@puppeteer/browsers": "^3.2.0"
  },
  "volta": {
    "node": "26.8.1"
  },
  "knip": {
    "entry": [
      "src/lib/imageLoader.ts"
    ]
  },
  "allowScripts": {
    "fsevents@2.3.2": true,
    "fsevents@2.3.3": true,
    "lefthook@2.1.9": true,
    "unrs-resolver@1.12.2": true
  }
}
